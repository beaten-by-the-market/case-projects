# CHECK API 게이트웨이 (원격 PC에서 띄운 공개버전) — 값은 source/CHECK_API_Colab_게이트웨이.ipynb 1번 셀
CHECK_GW_URL=https://<게이트웨이 주소>
CHECK_GW_KEY=ckgw_...
CHECK_GW_CA=.secrets/gateway-root-ca.crt
# 서버 인증서가 만료돼 있을 때만: 루트 CA로 체인 검증을 마친 leaf 의 SHA-256 지문 (docs/03-데이터출처.md §게이트웨이)
CHECK_GW_FP=

# OpenDART 인증키 (재무제표 원문 URL·목차 위치 조회용)
DART_API_KEY=
