# 자격증명 (.env.example 만 커밋)
.env

# 원본 응답 캐시 — OpenDART 목록 페이지·KIND 스냅샷·DART 화면. 스크립트로 다시 받는다
data/raw/

# 정관 스캔 이미지 — 용량이 커서 커밋하지 않는다. s04 로 다시 받는다 (meta.json 에 sha256 기록)
data/charter/**/img/

# PDF 로 첨부된 정관 원본(data/charter/**/pdf/, 31개 약 17MB)은 커밋한다 — 이미지와 달리 작다

# 소집공고 XML 원문 — 용량이 커서 커밋하지 않는다. s06 으로 다시 받는다 (meta.json 에 sha256 기록).
# 추출한 정관의변경.txt·meta.json 은 커밋한다
data/agm/**/*.xml

# 코스닥 확장 (sNNk_kosdaq_*.py) — 코스피와 같은 규칙
data/charter_kosdaq/**/img/
data/agm_kosdaq/**/*.xml

# 사업보고서 없는 회사의 정관 (s04e, 01 R8) — 코스피와 같은 규칙
data/charter_absent/**/img/
data/charter_absent_src/**/img/
data/agm_absent/**/*.xml

# 확인필요 회사의 전년도 정관 (s09f) — 코스피와 같은 규칙
data/charter_prev/**/img/
data/charter_kosdaq_prev/**/img/
data/agm_pre/**/*.xml
data/agm_kosdaq_pre/**/*.xml

# 서브에이전트 작업 폴더 (pack 입력 in/ · 결과 out/) — 결과는 ingest 로 s09*_results·s09i_pre_agm·llm_ocr 에 들어가므로 커밋하지 않는다
data/interim/*_agent*/
data/interim/absent/ocr_agent/

# 파이썬·노트북
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# 실행 로그
logs/*.log
